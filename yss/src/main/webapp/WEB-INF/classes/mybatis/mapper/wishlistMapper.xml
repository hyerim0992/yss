<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
	<mapper namespace="com.yss.mapper.WishlistMapper">

	<!-- 중첩 객체 매핑 -->
	<resultMap id="wishlistResultMap" type="com.yss.dto.wishListDTO">
		<id property="wishListId" column="WISHLISTID" />
		<result property="cratedAt" column="CREATEDAT" />
		<result property="memberId" column="MEMBERID" />
		<result property="productId" column="PRODUCTID" />
		
		<!-- ProductDTO 객체 매핑 -->
		<association property="product" javaType="com.yss.dto.ProductDTO">
			<id property="productId" column="PRODUCTID" />
			<result property="categoryId" column="CATEGORYID" />
			<result property="prodName" column="PRODNAME" />
			<result property="brand" column="BRAND" />
			<result property="price" column="PRICE" />
			<result property="discRate" column="DISCRATE" />
			<result property="salePrice" column="SALEPRICE" />
			<result property="thumbnail" column="THUMBNAIL" />
			<result property="status" column="STATUS" />
		</association>
	</resultMap>

	<!-- 마이페이지 위시리스트 목록 조회 -->
	<select id="selectWishlistList" parameterType="Long" resultMap="wishlistResultMap">
		SELECT 
			w.WISHLISTID,
			TO_CHAR(w.CREATEDAT, 'YYYY-MM-DD HH24:MI:SS') AS CREATEDAT,
			w.MEMBERID,
			p.PRODUCTID,
			p.CATEGORYID,
			p.PRODNAME,
			p.BRAND,
			p.PRICE,
			p.DISCRATE,
			CASE 
				WHEN p.DISCRATE IS NOT NULL AND p.DISCRATE > 0 
				THEN TRUNC(p.PRICE * (1 - p.DISCRATE / 100))
				ELSE p.PRICE 
			END AS SALEPRICE,
			p.THUMBNAIL,
			p.STATUS
		FROM WISHLIST w
		JOIN PRODUCT p ON w.PRODUCTID = p.PRODUCTID
		WHERE w.MEMBERID = #{memberId}
		ORDER BY w.WISHLISTID DESC
	</select>

	<!-- 3. 위시리스트 총 개수 조회 -->
	<select id="selectWishlistCount" parameterType="Long" resultType="int">
		SELECT COUNT(*)
		FROM WISHLIST
		WHERE MEMBERID = #{memberId}
	</select>

	<!-- 4. 특정 상품 중복 찜 여부 확인 ('Y' / 'N') -->
	<select id="checkIsWished" parameterType="map" resultType="String">
		SELECT 
			CASE WHEN COUNT(*) > 0 THEN 'Y' ELSE 'N' END AS isWished
		FROM WISHLIST 
		WHERE MEMBERID = #{memberId} 
		  AND PRODUCTID = #{productId}
	</select>

	<!-- 5. 위시리스트 상품 추가 -->
	<insert id="insertWishlist" parameterType="map">
		INSERT INTO WISHLIST (WISHLISTID, CREATEDAT, MEMBERID, PRODUCTID)
		VALUES (wishlistSeq.NEXTVAL, SYSDATE, #{memberId}, #{productId})
	</insert>

	<!-- 6. 단일 항목 삭제 -->
	<delete id="deleteWishlist" parameterType="map">
		DELETE FROM WISHLIST 
		WHERE WISHLISTID = #{wishListId} 
		  AND MEMBERID = #{memberId}
	</delete>

	<!-- 7. 선택 항목 다중 삭제 -->
	<delete id="deleteWishlistList" parameterType="map">
		DELETE FROM WISHLIST 
		WHERE MEMBERID = #{memberId} 
		  AND WISHLISTID IN 
		  <foreach collection="wishListIds" item="id" open="(" separator="," close=")">
			  #{id}
		  </foreach>
	</delete>

	<!-- 8. 전체 삭제 -->
	<delete id="deleteAllWishlist" parameterType="Long">
		DELETE FROM WISHLIST 
		WHERE MEMBERID = #{memberId}
	</delete>

</mapper>

<!-- 
CREATE TABLE WISHLIST (
	WISHLISTID	NUMBER		NOT NULL,
	CREATEDAT	DATE		DEFAULT SYSDATE NOT NULL,
	MEMBERID	NUMBER		NOT NULL,
	PRODUCTID	NUMBER		NOT NULL,
	CONSTRAINT PK_WISHLIST PRIMARY KEY (WISHLISTID),
	CONSTRAINT UK_WISHLIST_MEMBER_PRODUCT UNIQUE (MEMBERID, PRODUCTID)
);

CREATE SEQUENCE wishlistSeq START WITH 1 INCREMENT BY 1;
-->