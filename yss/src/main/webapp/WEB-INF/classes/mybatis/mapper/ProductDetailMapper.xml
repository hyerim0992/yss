<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yss.mapper.ProductDetailMapper">
	<select id="selectProductDetail" parameterType="Long" resultType="com.yss.dto.ProductDTO">
		SELECT p.productId, p.categoryId, p.prodName, p.price, p.discRate,
		       p.thumbnail, p.brand,
		       po.optionId, po.prodSize, po.color, po.addPrice,
		       pi.imageId, pi.files, pi.sortOrder
		FROM product p
		INNER JOIN productOption po ON p.productId = po.productId
		INNER JOIN productImage pi ON p.productId = pi.productId
		WHERE p.productId = #{productId}
	</select>
</mapper>

